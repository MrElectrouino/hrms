{
  "name": "swan-hrms",
  "version": "0.1.0",
  "private": true,
  "description": "HRMS modernization — NestJS + Prisma + PostgreSQL (phase-2 scaffold; legacy repo remains a read-only reference)",
  "scripts": {
    "postinstall": "prisma generate",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "db:seed": "npm run prisma:migrate:dev && npm run prisma:seed",
    "create-admin": "ts-node scripts/create-admin.ts",
    "provision-company": "ts-node scripts/provision-company.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/winston": "^2.4.4",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "rimraf": "^6.1.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "webpack": "^5.112.2"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^1.6.15",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/swagger": "^12.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "helmet": "^8.3.0",
    "nodemailer": "^10.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "engines": {
    "node": "24.x",
    "note": "Pinned to Node 24 for Vercel services compatibility."
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*.spec.ts$",
    "transform": {
      "^.+.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
