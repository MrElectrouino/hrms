// ============================================================================
// HRMS Modernization — Prisma Schema DRAFT (Phase 2, ARCH-02)
// ============================================================================
// Status: DRAFT — design artifact for review. No migration has been run.
// Source of truth: planning/DATABASE_DISCOVERY.md (live legacy schema evidence)
//                  planning/BUSINESS_RULES.md (behavior contracts)
// Scope: Phase-1 modules only — User Management, Setup/Master Data, Documents.
//
// COMMENT CONVENTIONS (read me):
//   /// legacy: ...  — maps 1:1 to a legacy table/column; IDs are PRESERVED
//                      so the ETL can migrate rows without renumbering.
//   // NEW: ...     — an addition that does NOT exist in the legacy system
//                      (new table, new column, new constraint, or changed
//                      semantics). Every NEW element carries the decision ID
//                      (DECISIONS.md) that justifies it.
//   // FIX: ...     — a deliberate correction of a legacy defect.
//   // OUT-OF-SCOPE — column kept only for data parity; not used by phase-1 APIs.
//
// Conventions:
//   - PostgreSQL, single `public` schema (schema-level separation can be added
//     later for least-privilege roles if needed — see SECURITY_REVIEW §2 DB access).
//   - Timestamps: timestamptz (UTC) — approved target convention (D-018). Legacy
//     wall-clock values are converted during ETL (UAE = fixed UTC+04, no DST,
//     so conversion is deterministic). If the owner rejects UTC, switch these
//     to @db.Timestamptz(3) -> timestamp(3) and keep wall-clock semantics.
//   - Catalog tables (UserType, Role, Parameter, DocumentType, Message) keep
//     legacy integer IDs as primary keys — they are business-editable data,
//     NOT enums, because users can add values at runtime in legacy.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URL moved to prisma.config.ts (see repo root).
// Using DATABASE_URL_UNPOOLED there — the unpooled/direct connection, since
// Prisma 7 dropped the separate directUrl and migrations need a direct
// connection, not Neon's PgBouncer pooler.
datasource db {
  provider = "postgresql"
}

// ============================================================================
// MODULE 1 — USER MANAGEMENT
// ============================================================================

/// legacy: master.UserType (4 rows: 1=Executive, 2=Manager, 3=SystemAdmin, 4=HRAdmin)
/// Legacy IDs preserved; menu visibility is keyed off this table (BR-UM-20/29).
model UserType {
  id              Int                      @id @default(autoincrement())
  name            String                   @unique
  isActive        Boolean                  @default(true)
  displayOrder    Int                      @default(0)
  users           User[]
  menuPermissions MenuUserTypePermission[]

  @@map("user_types")
}

/// legacy: master.Role (Admin/Manager/Employee + duplicated "Admin").
/// FIX (D-016): legacy had two rows named "Admin" (RoleId 1 & 7) and NO unique
/// constraint; dedup happens in ETL and `name` is unique here.
/// NOTE: in legacy this table is vestigial for menus (UserType drives access,
/// BR-UM-29) but is referenced by Profile/Employee metadata; kept for parity.
/// (No FK exists between Role and Profile in the legacy DB — none modeled.)
model Role {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)

  @@map("roles")
}

/// legacy: usr.Profile (852 rows) — the central "person" record.
/// FIX (D-015): legacy stored PassportNo/EmiratesId/MOLNo/VisaNo as PLAINTEXT
/// varchar(50). Here every PII identity number is stored twice:
///   * `xxxEnc`  — AES-256-GCM ciphertext (application-level envelope
///                 encryption; keys in env/KMS, never in the DB).
///   * `xxxHash` — keyed HMAC-SHA256 of the normalized value, used ONLY for
///                 equality lookups (ciphertext can't be searched). Indexed,
///                 non-unique (two profiles may legitimately share a number,
///                 e.g. dependants).
/// APIs must never return `*Enc` in lists (mask last-4 via decrypted view).
model Profile {
  id                 Int       @id @default(autoincrement())
  /// legacy: UserTypeId_1 — legacy kept a user-type copy on Profile; likely
  /// redundant with User.userTypeId. Kept nullable only for ETL parity.
  userTypeId         Int?
  /// legacy: StatusId -> system.Parameter (4=Active, 5=Inactive)
  statusId           Int?
  /// legacy: CutomerId (sic) — legacy typo; meaning unresolved (OQ-15 follow-up).
  /// Kept nullable for ETL parity; do not expose in APIs.
  customerId         Int?
  name               String
  middleName         String?
  lastName           String?
  /// Legacy duplicate-email checks were proc-level. Target validation should
  /// normalize emails case-insensitively; a final uniqueness policy remains a
  /// migration/business decision because the legacy DB has no email UQ.
  email              String?
  contactNo          String?
  dateOfBirth        DateTime? @db.Date
  /// legacy: MaritalStatus/Gender/BloodGroup/MotherTongue/Nationality/VisaType ->
  /// system.Parameter catalog values (kept as FKs, IDs preserved)
  maritalStatusId    Int?
  genderId           Int?
  motherTongueId     Int?
  bloodGroupId       Int?
  nationalityId      Int?
  visaTypeId         Int?
  /// legacy: PhotoId -> master.FileDoc
  photoFileId        BigInt?
  address            String?   @db.Text
  /// legacy: LinkId — external PMS identifier used for link auto-login (427 rows).
  /// NEW: nullable + unique — legacy had neither constraint nor uniqueness.
  linkId             Int?      @unique
  isSiteAccess       Boolean   @default(false)
  qualification      String?   @db.Text
  homeCountryAddress String?   @db.Text
  homeCountryPhoneNo String?
  contractTypeId     Int?
  dateOfExit         DateTime? @db.Timestamptz(3)
  exitReasonCode     Int?
  exitRemarks        String?   @db.Text
  dateOfRejoining    DateTime? @db.Timestamptz(3)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  /// legacy: CreatedBy/CreatedDate mapped to createdById/createdAt.
  createdById Int?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  user            User?
  employee        Employee?
  photoFile       StoredFile?            @relation("ProfilePhoto", fields: [photoFileId], references: [id])
  uploadedFiles   StoredFile[]           @relation("UploadedFiles")
  dependantsOwned Dependant[]            @relation("DependantProfile")
  dependantsOf    Dependant[]            @relation("EmployeeProfile")
  documents       Document[]
  weeklyOffs      WeeklyOffAssignment[]
  holidays        HolidayCalendarEntry[]
  bankAccount     BankAccount?
  // NOT migrated from legacy Profile: `IsUpdated` (app-level dirty flag, no
  // business meaning found); column_id 7 was dropped in legacy (schema drift).

  @@index([statusId])
  @@map("profiles")
}

/// legacy: usr.SiteUser (510 rows) — ONLY has SiteUserId/ProfileId/UserTypeId/
/// UserName/Password in legacy. All login logic redesign lives here.
model User {
  id                 Int      @id @default(autoincrement())
  profileId          Int      @unique
  userTypeId         Int
  /// FIX (D-016): unique — legacy had NO unique constraint and 3 duplicate
  /// usernames in live data. Dedup resolved during ETL before this constraint
  /// is created. Case-insensitive match: store lowercase (app normalizes) or
  /// add `citext` extension in the initial migration (comment either way).
  username           String   @unique
  /// bcrypt hash of the password.
  passwordHash       String?
  /// Forces the change-password prompt (e.g. after an admin reset).
  mustChangePassword Boolean  @default(false)
  /// NEW: true = may work in every branch; false = only the branches in `branches`.
  /// System Admins are never restricted.
  allBranches        Boolean  @default(true)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  branches            UserBranch[]
  profile             Profile              @relation(fields: [profileId], references: [id])
  userType            UserType             @relation(fields: [userTypeId], references: [id])
  sessions            Session[]            @relation("UserSessions")
  activity            UserActivity?        @relation("Activity")
  activityLogs        ActivityLog[]        @relation("ActivityLogs")
  overrides           MenuUserOverride[]
  oneTimeTokens       OneTimeLoginToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

/// legacy: usr.SiteUserActivity (123 rows)
/// Behavior preserved (BR-UM-03): lock after 5 consecutive failed attempts,
/// reset counter on success.
/// NEW: `lockedUntil` — legacy locked users FOREVER with no unlock path
/// (admin had to edit the DB). Target adds an auto-unlock window (default
/// 30 min, configurable) — requires owner sign-off on the duration (see
/// BUSINESS_RULES BR-UM-03 comment).
model UserActivity {
  id                   Int       @id @default(autoincrement())
  userId               Int       @unique
  lastLoginAt          DateTime? @db.Timestamptz(3)
  lastIpUsed           String?
  passwordChangedAt    DateTime? @db.Timestamptz(3)
  isPasswordReset      Boolean   @default(false)
  failedLoginAttempts  Int       @default(0)
  isLocked             Boolean   @default(false)
  failedLoginAttemptAt DateTime? @db.Timestamptz(3)
  /// NEW: see model docblock. Null = permanent (legacy behavior).
  lockedUntil          DateTime? @db.Timestamptz(3)

  user User @relation("Activity", fields: [userId], references: [id])

  @@map("user_activities")
}

/// NEW — D-013 (forgot-password flow).
/// Legacy had no active reset-token table: the flow was commented out. Store
/// only a hash of the emailed one-time token; the raw token exists only in the
/// email URL. Tokens are short-lived, single-use, and invalidated after a
/// successful password change. Requests and completion are audit logged.
model PasswordResetToken {
  id          BigInt    @id @default(autoincrement())
  userId      Int
  tokenHash   String    @unique
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  requestedIp String?
  usedIp      String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

/// legacy: usr.SiteUserActivityLog (33,508 rows — ONLY "Login" events exist).
/// FIX (SEC-L-12 target): also log failed attempts, logouts, password
/// changes/resets — legacy never recorded them.
model ActivityLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int
  /// legacy: LogTypeId -> system.Parameter (ParameterTypeId 3). Legacy only
  /// ever wrote 6=Login. Kept as FK to Parameter so admins can extend types.
  logTypeId Int
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation("ActivityLogs", fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([logTypeId])
  @@map("activity_logs")
}

/// NEW — DECISION D-007.
/// Replaces legacy `system.Token` (opaque GUID, ExpiresOn=IssuedOn => never
/// expires, validated by existence only, returned/reused across logins).
/// Target: short-lived JWT access token (stateless, NOT stored) + this table
/// holds only the REFRESH session: hashed token, hard expiry, rotation and
/// revocation. Legacy token-reuse behavior (BR-UM-05) is intentionally NOT
/// reproduced — each login creates a new session (multi-device OK, OQ-12).
model Session {
  id               BigInt    @id @default(autoincrement())
  userId           Int
  /// SHA-256 of the refresh token; raw token never stored.
  refreshTokenHash String    @unique
  issuedAt         DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  lastUsedAt       DateTime  @db.Timestamptz(3)
  /// NEW: rotation support — when a refresh token is used it is marked
  /// rotated and replaced; reuse of a rotated token revokes the session
  /// (theft detection).
  rotatedAt        DateTime? @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  revokedReason    String?
  ipAddress        String?
  userAgent        String?
  /// NEW (D-022): all sessions created by rotating one login share a family.
  /// Reuse of a rotated token revokes the whole family, not every session.
  familyId         String    @default(uuid())
  /// NEW (D-022): start of the login. Absolute lifetime is measured from here,
  /// so rotation cannot extend a login past REFRESH_TTL_DAYS.
  familyStartedAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation("UserSessions", fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
  @@map("sessions")
}

/// NEW — replaces legacy `HRMS.Token` (4 rows; one-time link-login token).
/// Legacy: GetLogin deleted the row on use (delete-on-use "audit").
/// FIX: kept with usedAt/usedIp for an audit trail instead of deleting,
/// plus a hard expiry (legacy rows never expired).
model OneTimeLoginToken {
  id        BigInt    @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  /// NEW: legacy tokens were valid forever until used.
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  usedIp    String?

  user User @relation(fields: [userId], references: [id])

  @@map("one_time_login_tokens")
}

/// NEW — append-only audit trail (SECURITY_REVIEW §2 Audit logging).
/// Legacy had no audit beyond login events; target audits logins, lockouts,
/// password changes/resets, document view/download/upload/delete, master
/// data changes. This table is written by app code only; no API mutates it.
model AuditLog {
  id             BigInt   @id @default(autoincrement())
  /// Actor = acting profile (null for system/scheduler actions).
  actorProfileId Int?
  action         String
  entityType     String?
  entityId       String?
  ipAddress      String?
  /// Action-specific payload (e.g. masked PII, old/new value hashes).
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([actorProfileId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// legacy: system.MenuItem — menu tree (Employee List=1, Master Setup=2,
/// Department=6, Site=7, ... PageUrl like /profilelist, /mastersetup).
/// Menu IDs are hardcoded in the legacy Angular Constants.ts; they are
/// preserved exactly so the new frontend can adopt DB-driven menus without
/// renumbering (BR-UM-24).
model MenuItem {
  /// legacy: IDs are preserved exactly (frontend Constants.ts hardcodes them,
  /// BR-UM-24); autoincrement continues the sequence for NEW menu items.
  id           Int     @id @default(autoincrement())
  /// legacy: MenuParentValue — self-reference builds the tree.
  parentId     Int?
  name         String
  pageUrl      String?
  iconClass    String?
  displayOrder Int
  isMainMenu   Boolean @default(true)
  isActive     Boolean @default(true)

  parent              MenuItem?                @relation("MenuTree", fields: [parentId], references: [id])
  children            MenuItem[]               @relation("MenuTree")
  userTypePermissions MenuUserTypePermission[]
  userOverrides       MenuUserOverride[]

  @@map("menu_items")
}

/// legacy: system.MenuUserType — base menu rights per UserType
/// (PageUrl override + IsCreate/IsEdit/IsDelete toolbar flags).
/// Legacy save path was a MERGE proc (AddUpdateMenuUserType) -> plain upsert here.
model MenuUserTypePermission {
  id              Int     @id @default(autoincrement())
  userTypeId      Int
  menuItemId      Int
  /// legacy: per-UserType PageUrl override (falls back to MenuItem.pageUrl).
  pageUrlOverride String?
  isCreate        Boolean @default(false)
  isEdit          Boolean @default(false)
  isDelete        Boolean @default(false)

  userType UserType @relation(fields: [userTypeId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([userTypeId, menuItemId])
  @@map("menu_user_type_permissions")
}

/// legacy: system.MenuSpecialUserAccess — per-USER include/exclude overrides
/// applied on top of the UserType base rights (GetSiteUserMenuItem logic).
model MenuUserOverride {
  id              Int     @id @default(autoincrement())
  userId          Int
  menuItemId      Int
  /// legacy: isInclude bit — true = grant to this user, false = revoke.
  isInclude       Boolean
  pageUrlOverride String?

  user     User     @relation(fields: [userId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@unique([userId, menuItemId])
  @@map("menu_user_overrides")
}

/// legacy: system.Message — message catalog.
/// DECISION D-010: MessageIds are preserved verbatim (2=invalid login, 4=success,
/// 5=updated, 6=email exists, 7=employee code exists, 10=holiday exists,
/// 11/12=WOF conflicts, 28=shift exists, ...) so existing frontend wording and
/// E2E parity tests keep working. `code` (NEW) is the stable string slug the
/// new frontend keys off; `text` keeps the legacy wording at cutover.
model Message {
  /// legacy MsgId preserved verbatim (D-010); sequence continues for new codes.
  id            Int     @id @default(autoincrement())
  code          String  @unique
  text          String
  shortDesc     String?
  /// legacy: MessageTypeId -> system.Parameter (7=Error, 8=Warning, 9=Success)
  messageTypeId Int
  displayOrder  Int     @default(0)

  @@map("messages")
}

/// legacy: system.Configuration (25 rows: CompOff expiry, PayrollMonth,
/// RamadanDates, ...). Config 13 "PayrollPassword" is a SECRET and is NOT
/// migrated — it goes to the secret manager (SEC-L-19).
/// NEW: `valueKind` tag so the app can coerce values safely instead of
/// stringly-typed parsing everywhere.
model SystemConfiguration {
  /// legacy ConfigId preserved (1..25 seeded); sequence continues.
  id          Int       @id @default(autoincrement())
  name        String    @unique
  value       String?
  valueDate   DateTime? @db.Date
  /// NEW: string|number|date|secret (secret values are rejected at seed time).
  valueKind   String    @default("string")
  description String?

  @@map("system_configurations")
}

/// legacy: system.ParameterType (1=UserType, 2=UserStatus, 3=LogType,
/// 4=MessageType, 5=Data Type, 6=Field Data Type, 8=PassportType, ...)
model ParameterType {
  /// legacy ParameterTypeId preserved (1,2,3,4,5,6,8,...).
  id         Int         @id @default(autoincrement())
  name       String      @unique
  parameters Parameter[]

  @@map("parameter_types")
}

/// legacy: system.Parameter — the generic catalog behind every dropdown
/// (gender, blood group, marital status, passport type, log types, ...).
/// Legacy IDs preserved everywhere (Profile.genderId -> ParameterId 33/34/35).
model Parameter {
  id              Int     @id @default(autoincrement())
  parameterTypeId Int
  text            String
  /// legacy: ParameterValue — legacy semantic value (e.g. StatusId 4 maps to
  /// ParameterValue 1 "Active"). Preserved for ETL parity; app logic reads
  /// `text`/code, never assumes the numeric value.
  parameterValue  Int?
  displayOrder    Int     @default(0)
  /// legacy: Visibility — hidden options stay in data but are filtered out.
  isVisible       Boolean @default(true)
  /// NEW: stable slug for new code (legacy only had text).
  code            String?

  parameterType ParameterType @relation(fields: [parameterTypeId], references: [id])
  codeSequence  EmployeeCodeSequence?
  /// Employees whose branch this is (parameter type "Branch").
  branchEmployees Employee[]   @relation("EmployeeBranch")
  /// Accounts allowed to work in this branch.
  branchUsers     UserBranch[] @relation("UserBranchParameter")
  /// Holiday calendars that belong to this branch.
  holidayCalendars HolidayCalendar[] @relation("HolidayCalendarBranch")
  /// Timezone override for this branch (parameter type "Branch").
  timezone        BranchTimezone?
  policyAssignments AttendancePolicyAssignment[] @relation("PolicyAssignmentBranch")

  @@unique([parameterTypeId, text])
  @@index([parameterTypeId])
  @@map("parameters")
}

// ============================================================================
// MODULE 2 — SETUP / MASTER DATA
// ============================================================================

/// legacy: master.Site (4 rows: Dubai Head Office, Abudhabi, Nepal, India)
/// No unique constraint existed in legacy; name unique is NEW (FIX, D-016 spirit).
model Site {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)

  employees        Employee[]
  weeklyOffConfigs WeeklyOffConfig[]
  holidayLists     HolidayList[]

  @@map("sites")
}

/// legacy: master.Language (UQ LanguageName in legacy too)
model Language {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)

  @@map("languages")
}

/// legacy: master.Shift (ShiftName/StartTime/EndTime/LateMinutes/
/// HalfDayMinutes/Alt times; times are `time` columns in legacy too).
/// FIX: name unique — legacy checked duplicates only inside the proc (race-
/// prone, BR-MD-05); MsgId 28 is the legacy duplicate error.
model Shift {
  id             Int       @id @default(autoincrement())
  name           String    @unique
  startTime      DateTime  @db.Time
  endTime        DateTime  @db.Time
  lateMinutes    Int
  halfDayMinutes Int
  /// legacy: AltStartTime/AltEndTime (present in table, unused by phase-1 UI)
  altStartTime   DateTime? @db.Time
  altEndTime     DateTime? @db.Time
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  createdById    Int?
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  employees Employee[]
  patternDays RosterPatternDay[]
  rosterEntries RosterEntry[]

  @@map("shifts")
}

/// legacy: system.WeeklyOffConfig — weekly-off pattern per site/year.
/// NEW: `daysOfWeek Int[]` replaces legacy CSV/flag storage; convention
/// documented here: 1=Sunday ... 7=Saturday (ISO-8601). App validates
/// 1..7 at write time (legacy accepted free-form values).
model WeeklyOffConfig {
  id         Int     @id @default(autoincrement())
  name       String
  siteId     Int?
  /// NEW: see docblock — replaces legacy CSV storage (BR-MD-18).
  daysOfWeek Int[]
  year       Int
  isActive   Boolean @default(true)

  site        Site?                 @relation(fields: [siteId], references: [id])
  assignments WeeklyOffAssignment[]

  @@unique([siteId, year, name])
  @@map("weekly_off_configs")
}

/// legacy: system.WeeklyOffList — stored WOFListId/WOFId/Year/PrevYear/ProfileId
/// and a CSV of SiteIds in a varchar(200) column.
/// NEW shape: one row per (employee, year) pointing at a config — replaces the
/// CSV column with a real relation (FIX of BR-MD-18). Prev-year carryover is
/// represented by the previous year's row, not a duplicate copy.
model WeeklyOffAssignment {
  id                Int @id @default(autoincrement())
  profileId         Int
  weeklyOffConfigId Int
  year              Int

  profile Profile         @relation(fields: [profileId], references: [id])
  config  WeeklyOffConfig @relation(fields: [weeklyOffConfigId], references: [id])

  @@unique([profileId, year])
  @@map("weekly_off_assignments")
}

/// legacy: master.HolidayList (9 rows — named holiday calendars per site)
model HolidayList {
  id       Int     @id @default(autoincrement())
  name     String
  siteId   Int?
  isActive Boolean @default(true)

  entries HolidayCalendarEntry[]
  site    Site?                  @relation(fields: [siteId], references: [id])

  @@map("holiday_lists")
}

/// legacy: HolidayCalendar — per-profile assigned holidays with
/// PrevHolidayDate carryover semantics (BR-MD-12).
model HolidayCalendarEntry {
  id              Int       @id @default(autoincrement())
  holidayListId   Int
  profileId       Int
  date            DateTime  @db.Date
  /// legacy: PrevHolidayDate — used when a holiday shifts across the
  /// employment year boundary; kept because leave calculations depend on it.
  prevHolidayDate DateTime? @db.Date

  holidayList HolidayList @relation(fields: [holidayListId], references: [id])
  profile     Profile     @relation(fields: [profileId], references: [id])

  @@unique([profileId, holidayListId, date])
  @@map("holiday_calendar_entries")
}

/// legacy: system.MetaData (42 rows) — logical form entities
/// (1=Language, 2=Role, 3=Site, 4=Department, 5=Basic Profile, 6=Work Employee,
/// 7=Bank, 8=Document, ...).
/// NEW (DECISION D-003): this is the SAFE re-modeling of the legacy metadata
/// engine. Legacy used these rows to build dynamic SQL by string concatenation
/// (SEC-L-03). Here they only DRIVE THE UI (form sections, fields, validation)
/// and never generate SQL — every master is a typed table (Department, Site,
/// ... above). `tableName`/`primaryKeyColumn` are kept as reference metadata
/// pointing at typed models, never interpolated into queries.
model FormEntity {
  /// legacy MetaDataId preserved (1..42); sequence continues for new entities.
  id               Int     @id @default(autoincrement())
  name             String
  /// NEW: stable slug (e.g. "department", "document") used by APIs instead of ids.
  key              String  @unique
  /// legacy: table name + pk column (documentation only — see docblock).
  legacyTableName  String?
  legacyPrimaryKey String?
  displayOrder     Int     @default(0)
  isActive         Boolean @default(true)

  fields FormField[]

  @@map("form_entities")
}

/// legacy: system.MetaDataDetail (241 rows) — field definitions.
/// legacy DataType catalog is FK'd to Parameter ParameterTypeId=6:
///   14=string, 15=password, 16=bit, 17=date, 19=byte, 20=int, 23=upload,
///   26=singleselect, 30=multiselect, 31=Text (BR-MD-16).
/// NEW (D-003): `config Json` absorbs the legacy free-form columns
/// (DropDownList sources, OnParentSelect cascades, ValidationText regex,
/// grid visibility, sectioning) in ONE typed place instead of 10 sparse
/// boolean/bit columns; `validationRegex` promoted out of config because it
/// is enforced server-side here (legacy enforced only client-side, BR-MD-03).
model FormField {
  /// legacy MetaDataDetailId preserved where possible; explicit seed IDs keep
  /// DocumentFieldValue.fieldId compatible with the legacy metadata extracts.
  id              Int     @id @default(autoincrement())
  entityId        Int
  fieldName       String
  displayName     String
  dataTypeId      Int
  isMandatory     Boolean @default(false)
  /// NEW: enforced server-side on writes (legacy: client-only).
  validationRegex String?
  isForeignKey    Boolean @default(false)
  /// For FK fields: which entity/catalog the dropdown reads from.
  foreignEntityId Int?
  displayOrder    Int     @default(0)
  isGridVisible   Boolean @default(true)
  /// legacy: DocumentType — marks document-type-specific fields (e.g.
  /// ExpiryDate variants per document type).
  documentTypeId  Int?
  /// NEW: absorbs legacy sparse columns (dropdown config, cascades, width...).
  config          Json?

  entity              FormEntity           @relation(fields: [entityId], references: [id])
  documentType        DocumentType?        @relation(fields: [documentTypeId], references: [id])
  documentFieldValues DocumentFieldValue[]

  /// Document MetaDataId has multiple `ExpiryDate` definitions, one per
  /// DocumentType; fieldName alone must therefore not be unique.
  @@unique([entityId, fieldName, documentTypeId])
  @@index([entityId])
  @@map("form_fields")
}

/// legacy: usr.Employee (PK EmployeeId; ProfileId FK).
model Employee {
  id                     Int       @id @default(autoincrement())
  profileId              Int       @unique
  /// FIX (D-016): unique — legacy had NO DB unique constraint (only a proc
  /// check emitting MsgId 7). Length parity: legacy nvarchar(20).
  employeeCode           String    @unique
  /// legacy: ReportingTo — self-relation (manager).
  reportingToId          Int?
  sourceOfHireId         Int?
  locationId             Int?
  siteId                 Int?
  employeeStatusId       Int?
  employeeTypeId         Int?
  contractTypeId         Int?
  workPhone              String?
  extension              String?
  workEmail              String?
  dateOfJoining          DateTime  @db.Timestamptz(3)
  dateOfConfirmation     DateTime? @db.Timestamptz(3)
  /// FIX (D-015): legacy PersonIDNumber was plaintext. Target stores the
  /// encrypted value and keyed lookup hash separately; API validation still
  /// enforces the legacy minimum length of 14 characters (BR-MD-07).
  personIdNumberEnc      String?
  personIdNumberHash     String?
  designation            String?
  shiftId                Int?
  isActive               Boolean   @default(true)
  exitUploadId           Int?
  // ---- OUT-OF-SCOPE columns kept for parity (payroll/attendance domain) ----
  isWPSProcessing        Boolean?
  isSalaryProcessing     Boolean?
  isAttendanceProcessing Boolean?
  companyMobileNo        String?
  companyLandNo          String?
  payrollSiteId          Int?
  isAllowedAdvanceLeave  Boolean?
  /// NEW: branch the employee belongs to; drives branch-scoped access (Administration > Branches).
  branchId               Int?

  profile     Profile    @relation(fields: [profileId], references: [id])
  /// NEW (D-023): profile sections 01–09 (Personal … System Access).
  profileSections    EmployeeProfileSection[]
  customFieldValues  CustomFieldValue[]
  reportingTo Employee?  @relation("ReportingTree", fields: [reportingToId], references: [id])
  reports     Employee[] @relation("ReportingTree")
  site        Site?      @relation(fields: [siteId], references: [id])
  shift       Shift?     @relation(fields: [shiftId], references: [id])
  branch      Parameter? @relation("EmployeeBranch", fields: [branchId], references: [id])
  workSchedules   EmployeeWorkSchedule[]
  rosterPatterns  EmployeeRosterPattern[]
  rosterEntries   RosterEntry[]
  holidayCalendars EmployeeHolidayCalendar[]
  attendance      Attendance[]
  regularizations AttendanceRegularization[]
  leaveApplications LeaveApplication[]
  leaveCredits    LeaveCredit[]
  leaveTransactions LeaveTransaction[]
  moodLogs        MoodLog[]
  policyAssignments AttendancePolicyAssignment[]

  @@index([siteId])
  @@index([branchId])
  @@index([reportingToId])
  @@index([personIdNumberHash])
  @@map("employees")
}

/// legacy: usr.Dependant — dependant documents live on the dependant's OWN
/// Profile row (legacy created real Profile rows for dependants).
model Dependant {
  id                 Int  @id @default(autoincrement())
  /// legacy: DependantProfileId — the dependant's own Profile row.
  dependantProfileId Int
  employeeProfileId  Int
  relationTypeId     Int?

  dependantProfile Profile @relation("DependantProfile", fields: [dependantProfileId], references: [id])
  employeeProfile  Profile @relation("EmployeeProfile", fields: [employeeProfileId], references: [id])

  @@unique([dependantProfileId, employeeProfileId])
  @@map("dependants")
}

/// legacy: usr.Account (bank details, MetaDataId 7 "Bank")
model BankAccount {
  id            Int     @id @default(autoincrement())
  profileId     Int     @unique
  /// Field names to be confirmed against a live SELECT of usr.Account during
  /// migration ETL build (bank name, IBAN/account no, currency).
  accountName   String?
  /// NEW (D-015): bank account numbers are treated as financial PII; store
  /// ciphertext + keyed lookup hash, never plaintext.
  accountNoEnc  String?
  accountNoHash String?
  bankName      String?
  isActive      Boolean @default(true)

  profile Profile @relation(fields: [profileId], references: [id])

  @@index([accountNoHash])
  @@map("bank_accounts")
}

// ============================================================================
// MODULE 3 — DOCUMENT MANAGEMENT
// ============================================================================

/// legacy: master.DocumentType (11 rows, UQ DocumentName):
/// 1=Passport, 2=Work Permit, 3=Emirates Id, 4=Health Insurance,
/// 5=Trade License, 6=Driving License, 106=nol, 107=Visa,
/// 108=Trafffic Fine (sic), 109=Warning Letter, 110=Accident Document.
/// IDs preserved (document expiry values are keyed by (documentType, field)).
model DocumentType {
  /// legacy DocumentTypeId preserved (1..6, 106..110); sequence continues.
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)
  /// NEW: when true, documents of this type must carry issue and expiry dates
  /// (and feed the expiry scheduler). When false, dates are not collected.
  hasExpiry Boolean @default(false)

  documents   Document[]
  formFields  FormField[]
  storedFiles StoredFile[]

  @@map("document_types")
}

/// legacy: HRMS.Document (3,279 rows / 3,126 active).
/// FIX (DATABASE_DISCOVERY §4): legacy `ExpiryDate` was a DEAD column (100%
/// NULL) — real expiry hid in AdditinalDocumentValue strings. Here expiry is
/// a first-class DATE column, populated by ETL from those strings and
/// maintained by the app from then on. Reporting/scheduler queries become
/// simple indexed reads instead of string parsing.
model Document {
  /// legacy: bigint identity — preserved (BigInt here).
  id             BigInt    @id @default(autoincrement())
  documentTypeId Int
  profileId      Int
  issueDate      DateTime? @db.Date
  /// NEW: first-class expiry (see docblock). Null = document has no expiry
  /// (e.g. some Health Insurance rows).
  expiryDate     DateTime? @db.Date
  /// FIX (D-015): legacy IdentityNo was free-text and may contain passport/
  /// Emirates-ID values. Encrypt at rest; use a keyed hash for equality search.
  identityNoEnc  String?
  identityNoHash String?
  documentTitle  String?
  remarks        String?   @db.Text
  isActive       Boolean   @default(true)
  /// legacy: IsSelf — self-service documents vs. company-held copies;
  /// report views filter on it (BR-DOC-18) — kept.
  isSelf         Boolean   @default(true)
  companyId      Int?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  createdById    Int?
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  documentType DocumentType         @relation(fields: [documentTypeId], references: [id])
  profile      Profile              @relation(fields: [profileId], references: [id])
  fieldValues  DocumentFieldValue[]
  files        DocumentFile[]
  expiryAlerts ExpiryAlertLog[]

  @@index([profileId, isActive])
  @@index([documentTypeId])
  @@index([identityNoHash])
  /// NEW: powers the expiry scheduler scans that legacy did with string
  /// conversion over AdditinalDocumentValue (BR-DOC-17).
  @@index([expiryDate, isActive])
  @@map("documents")
}

/// legacy: master.AdditinalDocumentValue (4,417 rows) — per-document extra
/// field values, keyed by MetaDataDetailId, ALL values as varchar(5000)
/// strings (dates stored as dd/mm/yyyy strings — the source of the mixed-
/// format bug, BR-DOC-15).
/// NEW shape: expiry (DataTypeId 17) is PROMOTED to Document.expiryDate; this
/// table keeps only the remaining extra fields. `valueEnc` applies D-015 if a
/// future extra field is classified PII; plain `value` otherwise.
model DocumentFieldValue {
  id         BigInt  @id @default(autoincrement())
  documentId BigInt
  /// legacy: MetaDataDetailId -> system.MetaDataDetail (28=Passport expiry,
  /// 1149/1150/1153/1154/1151 = other expiry fields, ...).
  fieldId    Int
  value      String?
  /// NEW: for sensitive extra fields only (D-015); null for normal values.
  valueEnc   String?

  document Document  @relation(fields: [documentId], references: [id])
  field    FormField @relation(fields: [fieldId], references: [id])

  @@unique([documentId, fieldId])
  @@map("document_field_values")
}

/// legacy: master.FileDoc (11,063 rows) — physical file records.
/// NEW (D-008): `storageKey` points into PRIVATE storage (folder outside web
/// root / object storage). Legacy stored a flat `FolderPath` under the API
/// root served UNAUTHENTICATED at /Documents (SEC-L-04) — that pattern is
/// abolished; every byte is streamed through an authorized endpoint.
/// `fileTypeId` (legacy FileDocTypeId -> DocumentType FK — legacy naming
/// confusion) is kept because the legacy column is real, but the D-016 ETL
/// re-derives it from the document mapping instead of trusting the hardcoded
/// "1" the legacy insert proc wrote.
model StoredFile {
  id               BigInt   @id @default(autoincrement())
  /// legacy: DocName (original display name)
  originalName     String
  /// legacy: FolderPath — retained only for migration reconciliation; target
  /// downloads use storageKey and never expose this path publicly.
  legacyFolderPath String?
  /// NEW: private-storage key (UUID-based; original name kept only here).
  storageKey       String   @unique
  /// NEW: enables correct content-disposition/preview handling.
  mimeType         String?
  /// NEW: integrity check + change detection.
  sizeBytes        BigInt?
  sha256           String?
  fileTypeId       Int?
  createdById      Int?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  isActive         Boolean  @default(true)

  fileType     DocumentType?  @relation(fields: [fileTypeId], references: [id])
  createdBy    Profile?       @relation("UploadedFiles", fields: [createdById], references: [id])
  profilePhoto Profile[]      @relation("ProfilePhoto")
  documents    DocumentFile[]
  brandingLogo    ApplicationBranding[] @relation("BrandingLogo")
  brandingFavicon ApplicationBranding[] @relation("BrandingFavicon")

  @@index([fileTypeId])
  @@map("stored_files")
}

/// legacy: master.FileDocMapping (3,269 rows) — links FileDoc rows to
/// Document rows (and to extra-column upload fields via MetaDataDetailId).
/// Legacy linkage was delete-then-reinsert on replace (BR-DOC-06); target
/// keeps an explicit many-to-many with `isCurrent` so file history is
/// auditable instead of being silently replaced.
/// NOTE: legacy also mapped files to NON-document owners (profiles etc.)
/// through other field ids; phase-1 models only the Document linkage —
/// extend with a polymorphic owner if phase-2 modules need more.
model DocumentFile {
  id           BigInt   @id @default(autoincrement())
  documentId   BigInt
  fileId       BigInt
  /// legacy: MetaDataDetailId when the file belongs to an extra upload field.
  fieldId      Int?
  /// NEW: replaces delete-then-insert history loss (see docblock).
  isCurrent    Boolean  @default(true)
  uploadedById Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  document Document   @relation(fields: [documentId], references: [id])
  file     StoredFile @relation(fields: [fileId], references: [id])

  @@unique([documentId, fileId, fieldId])
  @@index([fileId])
  @@map("document_files")
}

/// NEW — output record of the document-expiry scheduler (D-009).
/// Legacy compiled Excel sheets and mailed them to HR with NO record of what
/// was sent; dedup between runs was impossible. Each alert window per document
/// per run is logged here so runs are idempotent (unique constraint) and
/// auditable. Windows (BR-DOC-17): expired(prev-month..yesterday) / 7d / 1m / 3m.
model ExpiryAlertLog {
  id          BigInt   @id @default(autoincrement())
  documentId  BigInt
  /// "expired" | "7d" | "1m" | "3m"
  alertWindow String
  sentAt      DateTime @default(now()) @db.Timestamptz(3)
  recipients  String
  runId       String

  document Document @relation(fields: [documentId], references: [id])

  @@unique([documentId, alertWindow, runId])
  @@map("expiry_alert_logs")
}

// ============================================================================
// EMPLOYEE PROFILE (D-023) — nine profile sections and admin-defined custom fields
// ============================================================================

/// NEW (D-023): one document per employee per profile section. Field shape and
/// validation come from src/employee-profile/profile-schema.ts. Fields marked
/// sensitive there are stored encrypted (PiiService, D-015) inside `data`.
model EmployeeProfileSection {
  id                 Int      @id @default(autoincrement())
  employeeId         Int
  /// personal | employment | organization | attendance | compensation | bank | documents | education | access
  sectionKey         String
  data               Json
  updatedByProfileId Int?
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, sectionKey])
  @@map("employee_profile_sections")
}

/// NEW (D-023): admin-defined field (System Admin only). `code` is immutable once
/// created; labels can change; fields are deactivated, never deleted (values kept).
model CustomFieldDefinition {
  id                 Int      @id @default(autoincrement())
  code               String   @unique
  label              String
  tabKey             String
  sectionName        String
  fieldType          String
  options            Json     @default("[]")
  countryCode        String   @default("ALL")
  isRequired         Boolean  @default(false)
  isSensitive        Boolean  @default(false)
  /// NEW — System Admin > Custom Fields (planning/system_application_module.md §E).
  placeholder        String?
  helpText           String?
  isActive           Boolean  @default(true)
  displayOrder       Int      @default(0)
  createdByProfileId Int?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  values CustomFieldValue[]

  @@index([tabKey])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  definitionId Int
  value        Json
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  employee   Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id])

  @@unique([employeeId, definitionId])
  @@map("custom_field_values")
}

/// NEW (D-024): admin-defined salary template. Employees pick one in the
/// Compensation tab and enter a monthly amount per component.
/// components = [{ code, label }] in display order; codes stay stable after creation.
model SalaryTemplate {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  countryCode        String   @default("ALL")
  components         Json
  isActive           Boolean  @default(true)
  createdByProfileId Int?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  @@map("salary_templates")
}

/// NEW — System Admin > Country Configuration (planning/system_application_module.md §D).
/// `isoCode` is the same string used as `countryCode` on CustomFieldDefinition/SalaryTemplate
/// ("ALL" there is a sentinel meaning "every country", not a row here).
model Country {
  id              Int      @id @default(autoincrement())
  isoCode         String   @unique
  name            String
  currencyCode    String
  defaultTimezone String
  defaultLanguage String
  dateFormat      String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@map("countries")
}

/// NEW — System Admin > Application Branding (planning/system_application_module.md §A).
/// Singleton: always id=1, created lazily on first read. Unlike other StoredFile usage
/// (D-008, private/authenticated-only), the logo and favicon are served PUBLICLY
/// (GET /branding/logo, /branding/favicon, no auth) because the login page must render
/// them before the user signs in — a deliberate, narrow exception, not a precedent for
/// other file types.
model ApplicationBranding {
  id                 Int      @id @default(1)
  appName            String   @default("HRMS")
  logoFileId         BigInt?
  faviconFileId      BigInt?
  primaryColor       String?
  secondaryColor     String?
  accentColor        String?
  loginBrandingText  String?
  footerText         String?
  updatedByProfileId Int?
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  logoFile    StoredFile? @relation("BrandingLogo", fields: [logoFileId], references: [id])
  faviconFile StoredFile? @relation("BrandingFavicon", fields: [faviconFileId], references: [id])

  @@map("application_branding")
}

/// NEW — System Admin > Module Configuration (planning/system_application_module.md §G).
/// Single-tenant simplification: no per-organization assignment yet (no Organization model —
/// see the note at the top of system_application_module.md). `isImplemented` is separate from
/// `isEnabled`: most of these modules (Leave, Attendance, Payroll, ...) don't exist in code yet,
/// so toggling them here is a placeholder, not a real feature gate, until they're built.
model ModuleConfiguration {
  id             Int      @id @default(autoincrement())
  moduleKey      String   @unique
  name           String
  isEnabled      Boolean  @default(false)
  isImplemented  Boolean  @default(false)
  /// moduleKeys this module depends on; UI blocks disabling a module something else still needs.
  dependsOn      String[] @default([])
  displayOrder   Int      @default(0)
  updatedByProfileId Int?
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@map("module_configurations")
}

/// NEW — System Admin > Profile field rules. Per-country overrides on top of the
/// code-defined employee profile layout (src/employee-profile/profile-schema.ts).
/// Scope: sectionKey only = whole tab; + groupTitle = group; + fieldKey = field.
/// isVisible / isRequired null = inherit the code default.
model ProfileFieldRule {
  id                 Int      @id @default(autoincrement())
  countryCode        String
  sectionKey         String
  groupTitle         String   @default("")
  fieldKey           String   @default("")
  isVisible          Boolean?
  isRequired         Boolean?
  updatedByProfileId Int?
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  @@unique([countryCode, sectionKey, groupTitle, fieldKey], map: "profile_field_rules_scope_key")
  @@index([countryCode])
  @@map("profile_field_rules")
}


/// NEW — branches (parameters of type "Branch") an account may access when User.allBranches is false.
model UserBranch {
  userId   Int
  branchId Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Parameter @relation("UserBranchParameter", fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branches")
}

/// NEW — running number behind auto-generated employee codes. One row per Employee Type
/// parameter; its `code` is the prefix (e.g. PRM -> PRM-0001).
model EmployeeCodeSequence {
  parameterId Int @id
  lastNumber  Int @default(0)

  parameter Parameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@map("employee_code_sequences")
}

// ============================================================================
// TIME & ATTENDANCE SETUP — work schedules, holiday calendars, rosters, assignments
// ============================================================================

/// Required working time and start model. Times are "HH:mm" text (no timezone surprises).
model WorkSchedule {
  id                   Int      @id @default(autoincrement())
  code                 String   @unique
  name                 String   @unique
  /// FIXED (start/end) or FLEXIBLE (required minutes, optional start window).
  scheduleType         String
  startTime            String?
  endTime              String?
  /// Flexible only. Both empty = no start window.
  earliestStartTime    String?
  latestStartTime      String?
  requiredDailyMinutes Int
  /// Automatic break deduction: minus breakMinutes when worked at least breakAfterMinutes.
  breakMinutes         Int      @default(0)
  breakAfterMinutes    Int      @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  assignments EmployeeWorkSchedule[]

  @@map("work_schedules")
}

/// Effective-dated work schedule of an employee. effectiveTo null = open ended.
model EmployeeWorkSchedule {
  id             Int       @id @default(autoincrement())
  employeeId     Int
  workScheduleId Int
  effectiveFrom  DateTime  @db.Date
  effectiveTo    DateTime? @db.Date

  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workSchedule WorkSchedule @relation(fields: [workScheduleId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@map("employee_work_schedules")
}

/// A named holiday list. scope COMPANY | COUNTRY (countryCode) | BRANCH (branchId).
model HolidayCalendar {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  scope       String
  countryCode String?
  branchId    Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  branch      Parameter?                @relation("HolidayCalendarBranch", fields: [branchId], references: [id])
  holidays    Holiday[]
  assignments EmployeeHolidayCalendar[]

  @@map("holiday_calendars")
}

model Holiday {
  id          Int      @id @default(autoincrement())
  calendarId  Int
  date        DateTime @db.Date
  name        String
  holidayType String   @default("PUBLIC")

  calendar HolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@map("holidays")
}

/// Employee-level holiday calendar (the "EMPLOYEE" level of the inheritance order).
model EmployeeHolidayCalendar {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  calendarId    Int
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  calendar HolidayCalendar @relation(fields: [calendarId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@map("employee_holiday_calendars")
}

/// A repeating roster cycle (7, 14, 21 or 28 days). Each day is a shift or a weekly off.
model RosterPattern {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  cycleDays Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  days        RosterPatternDay[]
  assignments EmployeeRosterPattern[]

  @@map("roster_patterns")
}

model RosterPatternDay {
  id          Int     @id @default(autoincrement())
  patternId   Int
  /// 0-based position in the cycle.
  dayIndex    Int
  shiftId     Int?
  isWeeklyOff Boolean @default(false)

  pattern RosterPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  shift   Shift?        @relation(fields: [shiftId], references: [id])

  @@unique([patternId, dayIndex])
  @@map("roster_pattern_days")
}

/// Employee follows a pattern from effectiveFrom; anchorDate is the date where cycle day 0 falls.
model EmployeeRosterPattern {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  patternId     Int
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  anchorDate    DateTime  @db.Date

  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  pattern  RosterPattern @relation(fields: [patternId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@map("employee_roster_patterns")
}

/// A single-day roster entry (manual or imported). Overrides the employee's pattern for that date.
model RosterEntry {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  date        DateTime @db.Date
  shiftId     Int?
  isWeeklyOff Boolean  @default(false)
  /// MANUAL | IMPORT
  source      String   @default("MANUAL")
  createdById Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift?   @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, date])
  @@map("roster_entries")
}

/// History of Excel imports (roster and holidays).
model AttendanceImportLog {
  id           Int      @id @default(autoincrement())
  kind         String
  fileName     String
  totalRows    Int
  importedRows Int
  failedRows   Int
  errors       Json     @default("[]")
  createdById  Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@map("attendance_import_logs")
}

// ============================================================================
// ATTENDANCE MARKING — statuses, policies, daily records, punches, mood
// ============================================================================

/// One status list for every country. Legacy per-country ids only live in AttendanceStatusMapping.
model AttendanceStatus {
  code            String  @id
  name            String
  color           String  @default("#6b7280")
  sortOrder       Int     @default(0)
  /// WORK | ABSENCE | OFF | LEAVE
  category        String
  /// The late / half-day rule never changes a day that already has this status.
  skipsLateRule   Boolean @default(false)
  /// The day carries no punches and counts as not present (e.g. comp off availed).
  clearsPunches   Boolean @default(false)
  /// The only status(es) a manager may edit. Approving moves the day off it.
  managerEditable Boolean @default(false)
  isActive        Boolean @default(true)

  records  Attendance[]
  mappings AttendanceStatusMapping[]

  @@map("attendance_statuses")
}

/// Old ids per country, used only when migrating data and when comparing with the stored procedures.
model AttendanceStatusMapping {
  id           Int    @id @default(autoincrement())
  countryCode  String
  statusCode   String
  legacyId     Int
  legacyName   String

  status AttendanceStatus @relation(fields: [statusCode], references: [code])

  @@unique([countryCode, legacyId])
  @@map("attendance_status_mappings")
}

/// Settings that change a value, not the logic. Thresholds (late, half-day, Ramadan start) stay on the Shift.
model AttendancePolicy {
  id                         Int      @id @default(autoincrement())
  code                       String   @unique
  name                       String
  isActive                   Boolean  @default(true)
  /// Bumped on every change; stored on each processed day so history stays explainable.
  version                    Int      @default(1)
  lateEnabled                Boolean  @default(true)
  halfDayEnabled             Boolean  @default(true)
  allowPastDateSelfMarking   Boolean  @default(false)
  applyLateRulesToPastDates  Boolean  @default(false)
  /// Local time "HH:mm"; self-marking today after this is refused. Empty = no limit.
  selfMarkCutoffTime         String?
  /// HR may mark or correct after the cutoff.
  cutoffExemptHr             Boolean  @default(true)
  managerEditsOnlyUnapproved Boolean  @default(true)
  /// A self-marked day stays NOT_APPROVED (or LATE / HALF_DAY) until a manager or HR approves it.
  requiresApproval           Boolean  @default(true)
  useRamadanShiftStart       Boolean  @default(false)
  /// A day whose worked time is below the required time (after the grace) is marked SHORT_HOURS.
  shortHoursEnabled          Boolean  @default(true)
  shortHoursGraceMinutes     Int      @default(0)
  /// Worked time beyond the required time, after this many minutes, counts as overtime.
  overtimeEnabled            Boolean  @default(false)
  overtimeAfterMinutes       Int      @default(0)
  createdAt                  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime @updatedAt @db.Timestamptz(3)

  assignments AttendancePolicyAssignment[]

  @@map("attendance_policies")
}

/// scope EMPLOYEE | BRANCH | COUNTRY. The most specific active assignment wins.
model AttendancePolicyAssignment {
  id            Int       @id @default(autoincrement())
  policyId      Int
  scope         String
  countryCode   String?
  branchId      Int?
  employeeId    Int?
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  policy   AttendancePolicy @relation(fields: [policyId], references: [id])
  branch   Parameter?       @relation("PolicyAssignmentBranch", fields: [branchId], references: [id])
  employee Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([scope, countryCode])
  @@index([branchId])
  @@index([employeeId])
  @@map("attendance_policy_assignments")
}

model RamadanPeriod {
  id          Int      @id @default(autoincrement())
  countryCode String
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date

  @@index([countryCode, startDate])
  @@map("ramadan_periods")
}

model BranchTimezone {
  branchId Int    @id
  /// IANA name, e.g. Asia/Dubai
  timezone String

  branch Parameter @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_timezones")
}

/// Singleton (id 1): settings that apply to every employee.
model AttendanceSettings {
  id                 Int      @id @default(1)
  moodEnabled        Boolean  @default(true)
  /// OFF | OPTIONAL | REQUIRED
  gpsRequirement     String   @default("OPTIONAL")
  addressRequirement String   @default("OPTIONAL")
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  @@map("attendance_settings")
}

/// One row per employee per date, for every country. Times are UTC.
model Attendance {
  id             BigInt    @id @default(autoincrement())
  employeeId     Int
  date           DateTime  @db.Date
  shiftId        Int?
  policyId       Int?
  policyVersion  Int?
  statusCode     String
  isPresent      Boolean   @default(false)
  firstInAt      DateTime? @db.Timestamptz(3)
  lastOutAt      DateTime? @db.Timestamptz(3)
  lateMinutes    Int       @default(0)
  workedMinutes  Int?
  /// Required time from the work schedule (or the shift) and the gap / excess against the worked time.
  requiredMinutes Int?
  shortMinutes   Int       @default(0)
  overtimeMinutes Int      @default(0)
  /// Created by the daily job rather than by a person.
  isAutoGenerated Boolean  @default(false)
  leaveApplicationId Int?
  inIp           String?
  inCoordinates  String?
  inAddress      String?
  outIp          String?
  outCoordinates String?
  outAddress     String?
  /// SELF | MANAGER | HR
  source         String    @default("SELF")
  markedById     Int?
  markedAt       DateTime? @db.Timestamptz(3)
  approvedById   Int?
  approvedAt     DateTime? @db.Timestamptz(3)
  modifiedById   Int?
  modifiedAt     DateTime  @default(now()) @db.Timestamptz(3)
  remarks        String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status   AttendanceStatus @relation(fields: [statusCode], references: [code])
  leaveApplication LeaveApplication? @relation(fields: [leaveApplicationId], references: [id], onDelete: SetNull)
  punches  AttendancePunch[]

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance")
}

/// Every IN / OUT event. The day's first IN and last OUT are copied onto Attendance.
model AttendancePunch {
  id           BigInt   @id @default(autoincrement())
  attendanceId BigInt
  /// IN | OUT
  punchType    String
  at           DateTime @db.Timestamptz(3)
  ip           String?
  coordinates  String?
  address      String?
  /// SELF | MANAGER | HR
  source       String   @default("SELF")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId, at])
  @@map("attendance_punches")
}

/// One mood per employee per day, taken when they press IN. Options: parameter type "Mood".
model MoodLog {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime @db.Date
  mood       String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("mood_logs")
}

/// A request to correct a day (forgot to punch, wrong time). Approving it applies the corrected times.
model AttendanceRegularization {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  date         DateTime  @db.Date
  /// Local times (HH:mm) in the employee's timezone.
  requestedIn  String?
  requestedOut String?
  reason       String
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status       String    @default("PENDING")
  decidedById  Int?
  decidedAt    DateTime? @db.Timestamptz(3)
  decisionNote String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
  @@index([status])
  @@map("attendance_regularizations")
}

/// One run of the daily job (nightly or by hand).
model AttendanceProcessingRun {
  id           Int       @id @default(autoincrement())
  fromDate     DateTime  @db.Date
  toDate       DateTime  @db.Date
  /// CRON | MANUAL
  trigger      String
  createdDays  Int       @default(0)
  updatedDays  Int       @default(0)
  skippedDays  Int       @default(0)
  errors       Json      @default("[]")
  startedAt    DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt   DateTime? @db.Timestamptz(3)
  createdById  Int?

  @@map("attendance_processing_runs")
}

// ============================================================================
// LEAVE MANAGEMENT
// ============================================================================

model LeaveType {
  id               Int      @id @default(autoincrement())
  code             String   @unique
  name             String   @unique
  isPaid           Boolean  @default(true)
  /// false = usage is recorded but no balance is kept (for example loss of pay).
  balanceTracking  Boolean  @default(true)
  /// NONE | ANNUAL (credited at the start of the leave year) | MONTHLY (annualDays / 12 each month)
  accrual          String   @default("NONE")
  annualDays       Decimal  @default(0) @db.Decimal(6, 2)
  allowHalfDay     Boolean  @default(true)
  allowNegative    Boolean  @default(false)
  requiresDocument Boolean  @default(false)
  /// Document is only needed when the leave is longer than this many days (0 = always).
  documentAfterDays Int     @default(0)
  maxDaysPerRequest Int?
  /// Whether this type takes part in sandwich leave (also needs the organization switch).
  isSandwichEligible Boolean @default(false)
  /// Earned through comp off credits instead of accrual.
  isCompOff        Boolean  @default(false)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)

  applications LeaveApplication[]
  credits      LeaveCredit[]
  transactions LeaveTransaction[]

  @@map("leave_types")
}

/// Singleton (id 1): organization-wide leave settings.
model LeaveSettings {
  id                     Int      @id @default(1)
  sandwichEnabled        Boolean  @default(false)
  sandwichWeeklyOffs     Boolean  @default(true)
  sandwichHolidays       Boolean  @default(true)
  /// false = leave on either side of the off days triggers it; true = leave must be on both sides.
  sandwichRequireBothSides Boolean @default(false)
  /// Month the leave year starts (1 = January, 4 = April).
  leaveYearStartMonth    Int      @default(1)
  compOffEnabled         Boolean  @default(false)
  compOffCreditDays      Decimal  @default(1) @db.Decimal(4, 2)
  compOffExpiryDays      Int?     @default(90)
  compOffMinWorkedMinutes Int     @default(240)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)

  @@map("leave_settings")
}

/// A bucket of balance with its own expiry. Leave is taken from the earliest-expiring bucket first.
model LeaveCredit {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  leaveTypeId Int
  quantity    Decimal   @db.Decimal(6, 2)
  remaining   Decimal   @db.Decimal(6, 2)
  creditedOn  DateTime  @db.Date
  expiresOn   DateTime? @db.Date
  /// ACCRUAL | MANUAL | COMP_OFF | OPENING
  source      String
  /// Makes automatic credits safe to run twice (for example "2026-12" or "2026").
  sourceRef   String?
  note        String?
  createdById Int?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  allocations LeaveAllocation[]

  @@unique([employeeId, leaveTypeId, source, sourceRef])
  @@index([employeeId, leaveTypeId])
  @@map("leave_credits")
}

/// Which credits an approved application used, so a cancellation can give the days back.
model LeaveAllocation {
  id            Int     @id @default(autoincrement())
  applicationId Int
  creditId      Int
  days          Decimal @db.Decimal(6, 2)

  application LeaveApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  credit      LeaveCredit      @relation(fields: [creditId], references: [id])

  @@index([applicationId])
  @@map("leave_allocations")
}

/// Every change to a balance, for audit. days is positive for credits and negative for usage.
model LeaveTransaction {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  leaveTypeId   Int
  /// CREDIT | DEBIT | REVERSAL | EXPIRY | ADJUSTMENT
  kind          String
  days          Decimal  @db.Decimal(6, 2)
  applicationId Int?
  note          String?
  createdById   Int?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId, leaveTypeId])
  @@map("leave_transactions")
}

model LeaveApplication {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  leaveTypeId   Int
  fromDate      DateTime  @db.Date
  toDate        DateTime  @db.Date
  /// FIRST | SECOND, only for a single half day
  halfDayPart   String?
  /// Days asked for, extra days counted by the sandwich rule, and the total taken from the balance.
  requestedDays Decimal   @db.Decimal(6, 2)
  sandwichDays  Decimal   @default(0) @db.Decimal(6, 2)
  totalDays     Decimal   @db.Decimal(6, 2)
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status        String    @default("PENDING")
  reason        String?
  /// Every day with why it was counted (working, off day, sandwiched), kept as the audit of the calculation.
  calculation   Json      @default("[]")
  decidedById   Int?
  decidedAt     DateTime? @db.Timestamptz(3)
  decisionNote  String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  employee    Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType  @relation(fields: [leaveTypeId], references: [id])
  allocations LeaveAllocation[]
  attendance  Attendance[]

  @@index([employeeId, fromDate])
  @@index([status])
  @@map("leave_applications")
}
